# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/

# raw third-party model sources (large; processed output goes to public/anatomy)
/assets-src/

# report reader runtime files, copied from node_modules by scripts/copy-vendor.mjs
/public/vendor/

# real patient data must never be committed (AGENTS.md Section 75)
/private-reports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
